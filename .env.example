# Copy to .env and fill in. Used by compose.yml.
SLOFLIX_USER=
SLOFLIX_PASS=
# Optional settings, shown with their defaults (see `sloflixfs -h` and the README). Uncomment the matching
# line in compose.yml too.
#SLOFLIX_REFRESH=12h
#SLOFLIX_REVALIDATE=168h
#SLOFLIX_PROBE_CACHE=500
#SLOFLIX_RATE=1
#SLOFLIX_CONCURRENCY=3
# List only the newest N titles, e.g. 20 and 2 for a quick test (0 = all).
#SLOFLIX_LIMIT_MOVIES=0
#SLOFLIX_LIMIT_SHOWS=0
# Host directory the mount appears under (as $SLOFLIX_DIR/library).
#SLOFLIX_DIR=/mnt/sloflix
